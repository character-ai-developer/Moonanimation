# ---------------------------------------------------------------------------
# Vesper backend configuration
# Copy to .env and adjust. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# Port for the standalone API server (only used by `npm run server`).
# In `npm run dev` the API is mounted into the Vite dev server instead.
PORT=8787
HOST=0.0.0.0

# --- Roblox Open Cloud -------------------------------------------------------
# Optional but recommended. Create a key at:
#   https://create.roblox.com/dashboard/credentials
# and grant it the "Inventory read" scope.
#
# With a key:      inventory comes from the documented Open Cloud endpoint
#                  (apis.roblox.com/cloud/v2/users/{id}/inventory-items),
#                  paginated with pageToken / nextPageToken.
# Without a key:   the app falls back to the legacy public collectibles
#                  endpoint, which is also the only source of RAP + serials.
#
# The key is read on the server only. It is never sent to the browser and is
# deliberately excluded from GET /api/settings.
ROBLOX_API_KEY=

# --- Politeness / rate limits ------------------------------------------------
# Per-request timeout, in milliseconds.
ROBLOX_TIMEOUT_MS=8000
# Maximum concurrent Roblox requests (also caps Account Finder workers).
ROBLOX_MAX_CONCURRENCY=4
# Default minimum spacing between requests to the SAME host, in milliseconds.
# Rate limiting is per host: sensitive hosts (economy, avatar, Open Cloud) get
# their own larger spacing in server/lib/http.ts. 150ms measured clean on
# users / thumbnails / accountinformation / inventory.
ROBLOX_MIN_SPACING_MS=150
# Cap for the exponential per-host 429 backoff (base 500ms, doubling per
# consecutive 429 from that host only).
ROBLOX_BACKOFF_MS=30000
# A host that keeps 429-ing fails fast (circuit breaker) for this long.
ROBLOX_BREAKER_MS=20000
# Retries per request before giving up.
ROBLOX_MAX_RETRIES=2

# --- Scanning ceilings -------------------------------------------------------
# The desktop tool allowed 500,000 attempts (and effectively unbounded for
# nonstop). These defaults are deliberately much lower: mass enumeration is
# abusive to Roblox's infrastructure and against their terms of service.
SCAN_MAX_ATTEMPTS=20000
SCAN_MAX_RESULTS=2000

# --- Caching -----------------------------------------------------------------
CACHE_TTL_MS=300000
ASSET_CACHE_TTL_MS=3600000
# How long an assembled profile (RAP walk included) answers from memory.
PROFILE_CACHE_TTL_MS=120000
# Leave blank to use the in-memory cache. Reserved for a Redis adapter.
REDIS_URL=

# --- Persistence -------------------------------------------------------------
# Saved accounts file. The shape matches the desktop tool's rfinder_saved.json,
# so an existing file can be copied here unchanged.
SAVED_FILE=./data/saved.json

# --- Misc --------------------------------------------------------------------
# Comma-separated list of allowed origins for /api, or * for development.
CORS_ORIGINS=*
ROBLOX_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/129.0 Safari/537.36

# Isolated development fallback. When true, /api/users/* returns clearly
# labelled fabricated profiles instead of calling Roblox.
# This is OFF by default and must never be enabled in production.
VESPER_MOCK_MODE=false
